DirectoryIndex index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ── 1. Pass Authorization Header to PHP / Laravel (Crucial for Sanctum Bearer Tokens) ──
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ── 2. Allow OPTIONS Preflight Directly (Prevents CORS Redirect / Preflight Failure) ──
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^ index.php [L]

    # ── 3. Host-Lock (Allow api.dotoydo.com and localhost) ──
    RewriteCond %{HTTP_HOST} !^(api\.dotoydo\.com|127\.0\.0\.1|localhost)(:\d+)?$ [NC]
    RewriteRule .* - [F,L]

    # ── 4. Block Internal Files and Hidden Files (DO NOT block 'storage' - storage contains public uploaded images!) ──
    RewriteRule ^(app|bootstrap|config|database|routes|resources|tests|vendor)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.json|composer\.lock|package(-lock)?\.json|vite\.config\.js|phpunit\.xml|README\.md|DEPLOYMENT\.md|\.env(\.example)?)$ - [F,L]
    RewriteRule ^\. - [F,L]

    # ── 5. Redirect Trailing Slashes If Not A Folder (Skip for OPTIONS requests) ──
    RewriteCond %{REQUEST_METHOD} !OPTIONS
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # ── 6. Serve Real Files Directly (Uploaded images in /storage, public assets) ──
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ── 7. Laravel Front Controller Catch-All ──
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ── Security & Performance Headers ──
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ── Cache Uploaded Images & Static Assets ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
